;; signal-lojix — ORDINARY wire contract for the lojix deploy orchestrator.
;;
;; Wire-only: emits the rkyv + DOTOS codec and the signal-frame mail envelope.
;; No engine traits, no Nexus/SEMA content, no daemon behaviour. The
;; peer-callable read / observe / subscribe surface. Owner-only mutations
;; (Deploy/Pin/Unpin/Retire) live in meta-signal-lojix.
;;
;; This contract DEFINES the shared record types ONCE — meta-signal-lojix
;; cross-imports them via  signal-lojix:lib:TypeName.
;;
;; STREAMING (day-one decision 2tfa). schema cannot yet emit a
;; daemon-pushed event frame — no event/stream root, no opens/belongs
;; construct (verified against schema + schema-rust; the cloud
;; port never needed it). So the Watch/Unwatch SUBSCRIPTION HANDSHAKE is
;; authored in the emittable form (ordinary request -> SubscriptionToken
;; reply) and the two event payloads are defined once as namespace records,
;; so streaming is NOT dropped from the contract. The schema +
;; schema-rust event-frame-emission enhancement is the named follow-on
;; on the lojix path. Full argument + the provisional post-grammar event
;; root: ARCHITECTURE.md §4.

{}
[Query.QueryPayload WatchDeployments.WatchDeploymentsPayload WatchCacheRetention.WatchCacheRetentionPayload Unwatch.UnwatchPayload CheckHostKeyMaterial.CheckHostKeyMaterialPayload]
[Queried.QueriedPayload DeploymentEventsQueried.DeploymentEventsQueriedPayload TestRunsQueried.TestRunsQueriedPayload Watching.WatchingPayload Unwatched.UnwatchedPayload KeyMaterialChecked.KeyMaterialCheckedPayload QueryRejected.QueryRejectedPayload WatchRejected.WatchRejectedPayload UnwatchRejected.UnwatchRejectedPayload KeyMaterialCheckRejected.KeyMaterialCheckRejectedPayload]
;; TEST-OP SHARED TYPES (report 54). TestRunIdentifier, TestMode, and
;; HostSelection are DEFINED HERE — the ordinary contract owns the shared
;; record types once. meta-signal-lojix cross-imports them via
;; signal-lojix:lib:TypeName for the Test request, and the daemon's binary
;; config schema imports TestMode for its default. TestMode lives here (not in
;; meta) because the ordinary TestRunRecord below carries it; signal-lojix is
;; upstream of meta, so a shared type a read record needs must originate here.
{
  QueryPayload.Selection
  WatchDeploymentsPayload.DeploymentWatch
  WatchCacheRetentionPayload.CacheRetentionWatch
  UnwatchPayload.SubscriptionClose
  CheckHostKeyMaterialPayload.KeyMaterialQuery
  QueriedPayload.GenerationListing
  DeploymentEventsQueriedPayload.EventLogPage
  TestRunsQueriedPayload.TestRunListing
  WatchingPayload.SubscriptionOpened
  UnwatchedPayload.SubscriptionClosed
  KeyMaterialCheckedPayload.KeyMaterialReport
  QueryRejectedPayload.RejectedQuery
  WatchRejectedPayload.RejectedWatch
  UnwatchRejectedPayload.RejectedUnwatch
  KeyMaterialCheckRejectedPayload.RejectedKeyMaterialCheck

  DeploymentIdentifier.Integer
  GenerationIdentifier.Integer
  TestRunIdentifier.Integer
  SubscriptionToken.Integer
  CommitSequence.Integer
  StateDigest.Integer
  ClusterName.String
  NodeName.String
  UserName.String
  ClosurePath.String
  ProposalSource.String
  ImmutableRevision.String
  FlakeReference.String
  EventLogPosition.Integer
  PinLabel.String

  GenerationArtifact.[CompleteHost BaseHost UserEnvironment]
  HostComposition.[CompleteHost BaseHost]
  HostDeployAction.[Evaluate Realize SetBootProfile ActivateNow TestActivation ScheduleBootOnce]
  UserEnvironmentAction.[Realize SetProfile ActivateNow]
  SourceRevisionPolicy.[RequireImmutable ResolveAndRecord]
  ActivationEffect.[LiveActivation BootProfile TestActivation BootOnceProfile ProfileOnly]
  GenerationSlot.[Current BootPending Rollback Pinned Recent]
  DatabaseMarker.{ CommitSequence StateDigest }
  AdmissionMarker.DatabaseMarker
  TerminalMarker.DatabaseMarker
  TransitionMarker.DatabaseMarker

  ;; The test-run dispatch mode. Hermetic builds the pre-declared
  ;; .#checks.<system>.vm-<cluster>-<node> nixos test (sandboxed VM, no host
  ;; effect); Live drives the report-51 host-untouched cycle. Shared between
  ;; the meta Test op, the daemon config default, and the ordinary
  ;; TestRunRecord below. Report 54 decision C — two variants, no Both.
  TestMode.[Hermetic Live]

  ;; The multi-host picker. DefaultHost reads the daemon config default;
  ;; (OnHost <h>) overrides among the node's declared host-set. Shared so the
  ;; meta TestRun request and the durable record name one type.
  HostSelection.[DefaultHost (OnHost NodeName)]

  Generation.{
    GenerationIdentifier
    DeploymentIdentifier
    ClusterName
    NodeName
    GenerationArtifact
    ActivationEffect
    GenerationSlot
    ClosurePath
    Optional.ImmutableRevision
  }
  ;; A deployment is admitted before any effect runs and remains queryable until
  ;; its terminal record.  This record is the correlation boundary: a reader
  ;; can join the original request, the durable admission marker, and the
  ;; eventual result without relying on daemon logs or a transient connection.
  ;; The environment is a tagged identity, not an optional user field, so an
  ;; invalid host-with-user / user-environment-without-user row cannot exist.
  DeploymentEnvironment.[HostEnvironment (UserEnvironment UserName) LegacyUnknownEnvironment]
  ;; The request action is preserved exactly.  ActivationEffect is a derived
  ;; execution mode and cannot distinguish, for example, Evaluate from
  ;; ActivateNow or Realize from SetProfile.
  RequestedDeploymentAction.[(Host HostDeployAction) (UserEnvironment UserEnvironmentAction) LegacyUnknownAction]
  DeploymentRequestIdentity.{
    DeploymentEnvironment
    ClusterName
    NodeName
    GenerationArtifact
    RequestedDeploymentAction
    ActivationEffect
    SourceRevisionPolicy
    ;; Never expose a raw flake reference.  This is present only after strict
    ;; admission/resolution has proved an allowed immutable revision syntax.
    Optional.ImmutableRevision
  }
  ;; Completed is terminal for every successful request, including Evaluate and
  ;; Realize; Activated is an intermediate effect phase only.
  DeploymentLifecycle.[Submitted Building Built Copying Activating Activated Completed Rejected Failed LegacyUnknown LegacyAmbiguous]
  DeploymentFailureStage.[Admission FlakeAuth MaterializeHorizon Eval Build CopyClosure Activate Daemon]
  DeploymentTerminalReason.[ClusterUnknown NodeUnknown ProposalSourceUnreachable FlakeReferenceMalformed BuilderUnreachable SubstituterUnreachable DeploymentInFlight UnsupportedDeployAction InternalError ActivationFailed]
  DeploymentFailure.{ DeploymentFailureStage DeploymentTerminalReason }
  DeploymentTerminal.[Succeeded (Rejected DeploymentTerminalReason) (Failed DeploymentFailure) LegacyUnknown]
  DeploymentRecord.{
    DeploymentIdentifier
    GenerationIdentifier
    DeploymentRequestIdentity
    Optional.AdmissionMarker
    DeploymentLifecycle
    Optional.TerminalMarker
    Optional.DeploymentTerminal
  }
  GenerationListing.{ Vector.Generation Vector.DeploymentRecord DatabaseMarker }
  EventLogPage.{ Vector.DeploymentPhaseEvent Vector.CacheRetentionTransitionEvent DatabaseMarker }

  NodeSelector.{ ClusterName NodeName Optional.GenerationArtifact }
  GenerationLookup.{ GenerationIdentifier }
  EventLogRange.{ from.EventLogPosition until.EventLogPosition }

  ;; TEST-RUN QUERY (report 54 §5.3). (ByTestRun …) selects the durable
  ;; test-run outcomes over the ordinary read socket — write the test on the
  ;; meta socket, observe the result here, exactly as deploys already work.
  ;; The lookup names the cluster + node and optionally one run identifier;
  ;; None returns every run for that node, newest first.
  TestRunLookup.{ ClusterName NodeName Optional.TestRunIdentifier }
  DeploymentLookup.{ DeploymentIdentifier }
  Selection.[(ByNode NodeSelector) (ByGeneration GenerationLookup) (ByDeployment DeploymentLookup) (ByEventLog EventLogRange) (ByTestRun TestRunLookup)]

  ;; The durable test-run outcome record, returned by (Query (ByTestRun …)).
  ;; One row per submitted test: the run identifier, the resolved
  ;; cluster/node/host/mode, the lifecycle phase reached, the pass/fail
  ;; outcome, and (once known) the built closure under test. The daemon's SEMA
  ;; TestRunTable persists these; this wire shape is what the query reply
  ;; carries. A Pending outcome at phase Submitted is the freshly-accepted
  ;; test the Unit-2a stub records before any real dispatch (Unit 2b).
  TestRunPhase.[Submitted BringingUp Deploying Asserting TearingDown Completed Failed]
  TestOutcome.[Pending Passed (Failed FailureStage)]
  FailureStage.[BringUp Deploy Assert TearDown HermeticCheck]
  TestRunRecord.{
    TestRunIdentifier
    ClusterName
    node.NodeName
    host.NodeName
    TestMode
    TestRunPhase
    TestOutcome
    Optional.ClosurePath
  }
  TestRunListing.{ Vector.TestRunRecord DatabaseMarker }

  DeploymentWatch.{ Optional.DeploymentIdentifier Optional.ClusterName Optional.NodeName }
  CacheRetentionWatch.{ Optional.ClusterName Optional.NodeName }
  SubscriptionClose.{ SubscriptionToken }
  SubscriptionOpened.{ SubscriptionToken CommitSequence }
  SubscriptionClosed.{ SubscriptionToken }

  KeyMaterialQuery.{ ClusterName NodeName ProposalSource }
  KeyMaterialConcern.[SecureShellPublicKey YggdrasilPublicKey YggdrasilAddress]
  MismatchValue.String
  OperatorHint.String
  KeyMaterialMismatch.{ KeyMaterialConcern expected.MismatchValue actual.MismatchValue OperatorHint }
  KeyMaterialReport.{ NodeName Vector.KeyMaterialMismatch DatabaseMarker }

  DeploymentPhase.[Submitted Building Built Copying Activating Activated Completed Rejected Failed]
  DeploymentPhaseEvent.{
    DeploymentIdentifier
    GenerationIdentifier
    ClusterName
    NodeName
    DeploymentPhase
    EventLogPosition
    TransitionMarker
    Optional.ImmutableRevision
    Optional.DeploymentTerminal
  }
  CacheRetentionTransition.[Pinned Unpinned Promoted Demoted Retired Evicted]
  CacheRetentionTransitionEvent.{
    GenerationIdentifier
    ClusterName
    NodeName
    CacheRetentionTransition
    GenerationSlot
    Optional.GenerationSlot
    Optional.PinLabel
    EventLogPosition
  }

  QueryRejectionReason.[GenerationUnknown NodeUnknown EventLogPositionOutOfRange MalformedSelector]
  WatchRejectionReason.[SubscriptionLimitReached MalformedWatch StreamUnavailable]
  UnwatchRejectionReason.[SubscriptionTokenUnknown SubscriptionAlreadyClosed]
  KeyMaterialCheckRejectionReason.[NodeUnknown ProposalSourceUnreachable HostUnreachable PublicationMalformed]
  RejectedQuery.{ QueryRejectionReason DatabaseMarker }
  RejectedWatch.{ WatchRejectionReason }
  RejectedUnwatch.{ UnwatchRejectionReason SubscriptionToken }
  RejectedKeyMaterialCheck.{ KeyMaterialCheckRejectionReason DatabaseMarker }
}

{}
{}
