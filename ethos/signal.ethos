  ConfigurationRejected.ConfigurationRejection
  WatchRejected.RejectedWatch
  QueryRejected.RejectedQuery
  UnwatchRejected.RejectedUnwatch
  DeploymentPhaseObserved.DeploymentPhaseEvent
  Refused.StoreFailure ]

